{
  "name": "aldia-tarjetas",
  "version": "1.1.0",
  "private": true,
  "description": "Al Día — gestor de tarjetas de crédito, empaquetado como app de Android con Capacitor.",
  "scripts": {
    "build:www": "python3 build_www.py",
    "sync": "npm run build:www && npx cap sync android",
    "open:android": "npx cap open android",
    "test": "node --test tests/*.test.js",
    "test:e2e": "python3 build_www.py && node --test --test-concurrency=1 tests/e2e/app.e2e.js"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@tesseract.js-data/spa": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "playwright": "^1.56.1"
  }
}
